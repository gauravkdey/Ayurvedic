# Copy to .env (never commit .env)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
# First administrator (created once, on first run). Use a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
# Agent 2 (optional). Leave both keys empty to use the template rationale.
# Free option: Google Gemini key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Paid option: Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional: force one provider (gemini or anthropic)
LLM_PROVIDER=
